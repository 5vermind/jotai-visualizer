{
  "name": "jotai-visualizer-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Visualize Jotai atoms, dependencies, and React consumers as a graph.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.18.1",
    "pnpm": ">=10.28.0 <11"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm benchmark:graph && pnpm verify:production",
    "benchmark": "pnpm build && pnpm benchmark:graph",
    "benchmark:graph": "node scripts/benchmark-graph.mjs",
    "dev": "pnpm --filter @jotai-visualizer/example-vite-react dev",
    "lint": "eslint .",
    "pack:release": "node scripts/pack-packages.mjs",
    "release:verify": "pnpm check && pnpm pack:release && node scripts/verify-tarballs.mjs && node scripts/verify-consumer-install.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "verify:production": "node scripts/verify-production-build.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "16.4.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.0",
    "vite": "6.4.3",
    "vitest": "4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/5vermind/jotai-visualizer.git"
  },
  "homepage": "https://github.com/5vermind/jotai-visualizer#readme",
  "bugs": {
    "url": "https://github.com/5vermind/jotai-visualizer/issues"
  },
  "keywords": [
    "jotai",
    "react",
    "devtools",
    "visualization",
    "state-management"
  ]
}
