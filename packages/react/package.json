{
  "name": "@jotai-visualizer/react",
  "version": "0.1.0",
  "description": "React runtime instrumentation for Jotai Visualizer.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./instrumentation": {
      "types": "./src/instrumentation.ts",
      "import": "./dist/instrumentation.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@jotai-visualizer/core": "workspace:^",
    "@jotai-visualizer/ui": "workspace:^"
  },
  "peerDependencies": {
    "jotai": ">=2.20.0 <3.0.0",
    "react": ">=18.0.0 <20.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "jotai": "2.20.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "sideEffects": true,
  "engines": {
    "node": ">=20.18.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/5vermind/jotai-visualizer.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/5vermind/jotai-visualizer#readme",
  "bugs": {
    "url": "https://github.com/5vermind/jotai-visualizer/issues"
  },
  "keywords": [
    "jotai",
    "react",
    "devtools",
    "visualization"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./instrumentation": {
        "types": "./dist/instrumentation.d.ts",
        "import": "./dist/instrumentation.js"
      }
    }
  }
}
