{
  "name": "@jotai-visualizer/ui",
  "version": "0.1.0",
  "description": "Embedded graph UI for Jotai Visualizer.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -p tsconfig.build.json && node --input-type=module --eval \"import { copyFileSync } from 'node:fs'; copyFileSync('src/styles.css', 'dist/styles.css')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@jotai-visualizer/core": "workspace:^",
    "@xyflow/react": "12.11.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0 <20.0.0",
    "react-dom": ">=18.0.0 <20.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "engines": {
    "node": ">=20.18.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/5vermind/jotai-visualizer.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/5vermind/jotai-visualizer#readme",
  "bugs": {
    "url": "https://github.com/5vermind/jotai-visualizer/issues"
  },
  "keywords": [
    "jotai",
    "react",
    "devtools",
    "visualization"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./styles.css": "./dist/styles.css"
    }
  }
}
